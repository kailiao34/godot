<?xml version="1.0" encoding="UTF-8" ?>
<class name="WebSVGCircle" inherits="WebSVGElement" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../class.xsd">
	<brief_description>
		An SVG [code]&lt;circle&gt;[/code] element.
	</brief_description>
