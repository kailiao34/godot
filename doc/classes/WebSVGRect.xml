<?xml version="1.0" encoding="UTF-8" ?>
<class name="WebSVGRect" inherits="WebSVGElement" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../class.xsd">
	<brief_description>
		An SVG [code]&lt;rect&gt;[/code] element.
	</brief_description>
	<description>
		A rectangle in the scriptable SVG DOM, optionally with rounded corners. See [WebSVGElement] for the shared fill, stroke and transform properties.
	</description>
	<tutorials>
	</tutorials>
	<members>
		<member name="corner_radius" type="Vector2" setter="set_corner_radius" getter="get_corner_radius" default="Vector2(0, 0)">
			Horizontal ([member Vector2.x], SVG [code]rx[/code]) and vertical ([member Vector2.y], SVG [code]ry[/code]) corner radii.
		</member>
		<member name="position" type="Vector2" setter="set_rect_position" getter="get_rect_position" default="Vector2(0, 0)">
			Top-left corner, SVG [code]x[/code] and [code]y[/code].
		</member>
		<member name="size" type="Vector2" setter="set_rect_size" getter="get_rect_size" default="Vector2(0, 0)">
			Rectangle size, SVG [code]width[/code] and [code]height[/code].
		</member>
	</members>
</class>
